PORT=8080
NODE_ENV=development

# Required for Supabase access and startup schema preflight.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for Clerk auth verification.
CLERK_SECRET_KEY=sk_test_your_clerk_secret

# Optional admin allowlist (comma separated Clerk user ids).
SYSTEM_ADMIN_USER_IDS=

# Optional push configuration (web push; Expo push works without these).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@trailforge.app
