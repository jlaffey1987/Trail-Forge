# ============================================================
# TrailForge API Server - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
#
# HOW TO GET THESE VALUES:
# -------------------------
# 1. SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#    → Go to supabase.com → your project → Project Settings → API
#    → SUPABASE_URL = "Project URL"
#    → SUPABASE_SERVICE_ROLE_KEY = "service_role" key (keep this secret!)
#
# 2. CLERK_SECRET_KEY
#    → Go to dashboard.clerk.com → your TrailForge app → API Keys
#    → Copy the "Secret key" (starts with sk_test_ or sk_live_)
#    → This is DIFFERENT from the publishable key used in the mobile app
#
# 3. VAPID keys (for push notifications - can skip for now)
#    → Generate with: npx web-push generate-vapid-keys
#
# ============================================================

SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_WITH_SERVICE_ROLE_KEY

CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY

# Push notifications (optional - app works without these)
VAPID_SUBJECT=mailto:your@email.com
VAPID_PUBLIC_KEY=REPLACE_IF_NEEDED
VAPID_PRIVATE_KEY=REPLACE_IF_NEEDED

NODE_ENV=development
