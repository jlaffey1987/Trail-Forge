# ============================================================
# TrailForge Mobile - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
#
# HOW TO GET THESE VALUES:
# -------------------------
# 1. EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY
#    → Go to dashboard.clerk.com → your TrailForge app → API Keys
#    → Copy the "Publishable key" (starts with pk_test_ or pk_live_)
#
# 2. EXPO_PUBLIC_DOMAIN
#    → This is the URL of your running API server (WITHOUT https://)
#    → For local development: your laptop's local IP + port, e.g. 192.168.1.85:3000
#    → For Replit: your Replit dev domain (e.g. trail-forge-master.replit.app)
#    → Find your local IP by running: ipconfig (Windows) or ifconfig (Mac/Linux)
#
# ============================================================

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Your laptop's local IP address + API server port
# Run 'ipconfig' in Windows terminal to find your IPv4 address
EXPO_PUBLIC_DOMAIN=192.168.1.XX:3000
