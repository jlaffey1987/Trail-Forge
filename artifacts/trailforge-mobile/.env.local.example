# ============================================================
# TrailForge Mobile - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
#
# HOW TO GET THESE VALUES:
# -------------------------
# 1. EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY
#    → Go to dashboard.clerk.com → your TrailForge app → API Keys
#    → Copy the "Publishable key" (starts with pk_test_ or pk_live_)
#
# 2. EXPO_PUBLIC_API_BASE_URL
#    → URL of the TrailForge API server (include https:// or http://)
#    → Local development (same WiFi as your laptop):
#         EXPO_PUBLIC_API_BASE_URL=http://192.168.1.185:8080
#    → Production (Fly.io — works anywhere):
#         EXPO_PUBLIC_API_BASE_URL=https://trailforge-api.fly.dev
#
#    In Expo Go dev mode, the app can also derive your laptop IP from Metro
#    automatically when this variable is unset. Set it explicitly to use Fly.io
#    or a fixed local IP.
#
# 3. EXPO_PUBLIC_DOMAIN (legacy — prefer EXPO_PUBLIC_API_BASE_URL)
#    → Host only, without https:// (e.g. trailforge-api.fly.dev)
#
# ============================================================

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Local development:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.185:8080
# Production (update after Fly.io deployment):
# EXPO_PUBLIC_API_BASE_URL=https://trailforge-api.fly.dev
